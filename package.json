{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "dayjs-plugin-round",
  "author": "michaelhazan",
  "license": "MIT",
  "version": "0.0.5",
  "description": "A Dayjs plugin that adds a rounding function ",
  "keywords": [
    "dayjs",
    "dayjs plugin",
    "banker rounding",
    "iso80000-1:2022",
    "rounding",
    "round"
  ],
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "test": "vitest",
    "bench": "vitest bench",
    "bench:compare": "vitest bench --compare benchmark.json",
    "bench:update": "vitest bench --outputJson benchmark.json",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "check-exports": "npm run build && attw --pack",
    "release": "npm run build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@changesets/cli": "^2.29.5",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/types": "^19.8.1",
    "@eslint/js": "^9.31.0",
    "@faker-js/faker": "^10.1.0",
    "dayjs": "^1.11.13",
    "eslint": "^9.31.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "dayjs": "^1"
  },
  "packageManager": "pnpm@10.27.0+sha512.72d699da16b1179c14ba9e64dc71c9a40988cbdc65c264cb0e489db7de917f20dcf4d64d8723625f2969ba52d4b7e2a1170682d9ac2a5dcaeaab732b7e16f04a"
}
